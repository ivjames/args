# Copy to /var/www/args/.env (mode 600, gitignored). This file is the ONLY
# place the key lives on the box — there is no box-level key store. The pm2
# wrapper in bin/args sources it before exec'ing gunicorn.
ANTHROPIC_API_KEY=

# Optional: pricing used for the cost tracking (per million tokens).
#PRICE_IN_PER_MTOK=3.0
#PRICE_OUT_PER_MTOK=15.0
